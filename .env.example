# RevenueProof environment configuration.
# Copy to `.env` in the repository root and fill in. Never commit `.env`.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Security — CHANGE BOTH BEFORE ANY NON-LOCAL DEPLOYMENT
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRY_MINUTES=720
# Fernet key encrypting stored OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Data stores — defaults match infra/docker-compose.yml (non-standard ports so
# they cannot collide with a local Postgres/Redis you already run)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://revenueproof:revenueproof@localhost:55432/revenueproof
REDIS_URL=redis://localhost:56379/0
NEO4J_URI=neo4j://localhost:57687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=revenueproof
NEO4J_DATABASE=neo4j
CHROMA_HOST=localhost
CHROMA_PORT=58000
EVIDENCE_STORAGE_PATH=./data/evidence_vault

# ---------------------------------------------------------------------------
# LLM — Groq (free tier). REQUIRED for agent features; without it the app still
# runs and every deterministic financial calculation still works.
# Get a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# Proposer and critic MUST be different model families. Same-model agreement is
# not independent verification — see core_resoruces.md, Feature 7.
GROQ_MODEL_PROPOSER=llama-3.3-70b-versatile
GROQ_MODEL_CRITIC=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Evidence providers — all optional. Any source left blank falls back to the
# synthetic dataset (spec §15) and is labelled "synthetic" in the UI.
# ---------------------------------------------------------------------------

# Razorpay — Test Mode moves no real money.
# https://razorpay.com/docs/payments/dashboard/test-live-modes/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Zoho Books — OAuth app + organization ID.
# https://www.zoho.com/books/api/v3/oauth/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_REGION=in

# Google Drive — Cloud project with the Drive API enabled.
# https://developers.google.com/workspace/drive/api/guides/api-specific-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback

# HubSpot — optional CRM signal for entity resolution.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Resend — report-ready notifications (Feature 8).
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Financial policy defaults
# ---------------------------------------------------------------------------
BASE_CURRENCY=INR
DEFAULT_MATERIALITY_PCT=1.0
# Isolation Forest stays disabled below this record count rather than emitting
# an unstable anomaly score.
ML_MINIMUM_RECORDS=50
